node_modules
dist
# Location pages are generated from src/data/locations.js at build time
# (npm run pages). The generator is the source; these are output.
/smoke-forecast
# Same generator, same reason: /about/ is written by scripts/gen-location-pages.mjs.
/about
/how-smoke-forecasts-work
# The /guides/ articles are generated from content/articles/*.md by
# scripts/gen-articles.mjs. The markdown is the source; these are output.
/guides
/404.html
/public/sitemap.xml
.DS_Store
*.local
.vercel

# Apple: the Xcode project is generated from apple/project.yml (`make generate`),
# never committed — a .pbxproj is unreviewable and this repo's premise is that
# the four clients must not drift silently.
apple/Smokeshow.xcodeproj/
apple/.build/
# Xcode DerivedData written to custom -derivedDataPath names during device/sim
# builds. Build output, never committed.
apple/.build-device/
apple/.build-sim/
apple/.swiftpm/
apple/DerivedData/
xcuserdata/
scratch
# render + verify working dirs (frames go to the `data` branch, not here)
out
scratch
cams-cache
__pycache__
dist-review/
